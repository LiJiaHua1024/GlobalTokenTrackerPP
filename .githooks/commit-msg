#!/bin/sh
# Reject AI/tool self-attribution in commit messages — hard enforcement for
# every agent and tool committing to this repo, not just a convention doc.
msg="$1"
if grep -qiE '(generated[ -]with|co-?authored-?by:.*(devin|claude|cursor|copilot|codeium|windsurf|cognition|ai[-_ ]?integration|noreply.*bot)|🤖|signed-?off-?by:.*(devin|claude|cursor|copilot|bot))' "$msg"; then
    echo "commit-msg hook: AI/tool attribution trailer rejected." >&2
    echo "This repo forbids Generated-with / Co-Authored-By agent signatures." >&2
    echo "Remove the trailer and commit again." >&2
    exit 1
fi
exit 0
